# Scanonix environment variables
# Copy to .env.local and paste your Supabase credentials from the Connect dialog.
# Never commit .env.local or real credentials to version control.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: use non-www canonical origin — https://scanonix.com

# Supabase — Project Settings → API / Connect dialog
# Use the publishable (anon) key ONLY. Never add the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side aliases (scripts may read these as fallbacks)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — server-only (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=   # Enables cloud AI for scan analysis (Pro/Business) and document tools

# Phase 4A — document & image providers (server-only; routes return 503 if unset)
# CLOUDCONVERT_API_KEY=
# REALESRGAN_PYTHON=             # Path to Python with realesrgan + basicsr (Pro upscaler)
# REALESRGAN_ONNX_PATH=          # Optional ONNX model path instead of Python
# REALESRGAN_SERVICE_URL=        # External Real-ESRGAN worker (required on Vercel)
# REALESRGAN_SERVICE_SECRET=       # Optional bearer token for Real-ESRGAN worker (server-only)
# REMBG_PYTHON=                  # Path to Python with rembg + onnxruntime (background remover)
# REMBG_SERVICE_URL=             # External rembg worker (required on Vercel)
# REMBG_SERVICE_SECRET=          # Optional bearer token for rembg worker (server-only)
# REMBG_MODEL=isnet-general-use  # Default rembg model
# REMBG_MODEL_DIR=               # Optional local model cache directory (U2NET_HOME)

# Phase 4B — PDF compression & secure redaction (server-only; routes return 503 if unset)
# GHOSTSCRIPT_BIN=               # Ghostscript binary (gs on Linux/macOS, gswin64c on Windows)
# PDF_COMPRESSION_SERVICE_URL=   # External PDF compression worker (required on Vercel)
# PDF_REDACTION_PYTHON=          # Python with pymupdf installed (pip install pymupdf)
# PDF_REDACTION_SERVICE_URL=     # External PDF redaction worker (required on Vercel)

# Phase 5 — Real-ESRGAN NCNN Vulkan upscaler (server-only)
# REALESRGAN_BIN=                # Path to realesrgan-ncnn-vulkan executable
# REALESRGAN_MODEL_DIR=          # Folder containing pre-trained models
# REALESRGAN_MODEL=realesrgan-x4plus
# REALESRGAN_GPU_ID=             # Optional GPU id (omit for auto)

# Phase 8G — Async RunPod Real-ESRGAN upscale worker trigger (server-only)
# RUNPOD_API_KEY=                  # RunPod API key — never expose to browser
# RUNPOD_UPSCALE_ENDPOINT_ID=      # RunPod Serverless endpoint ID for poll_once worker
# RUNPOD_API_BASE_URL=https://api.runpod.ai/v2

# Optional domain reputation providers (server-only)
# GOOGLE_SAFE_BROWSING_API_KEY=
# URLHAUS_API_KEY=
# PHISHTANK_API_KEY=

# Stripe — test mode only for now
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_YEARLY_PRICE_ID=
# STRIPE_BUSINESS_MONTHLY_PRICE_ID=
# STRIPE_BUSINESS_YEARLY_PRICE_ID=

# Scheduled security monitoring cron (server-only)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production (Vercel). Local `next dev` skips cron auth — secret optional locally.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# See docs/scheduled-monitoring-cron.md for production setup.
# See docs/production-deployment.md for full launch checklist.
CRON_SECRET=

# Admin access — after running supabase/migrations/008_admin_role.sql, promote your user:
# UPDATE public.profiles SET role = 'admin' WHERE id = '<your-auth-user-uuid>';
